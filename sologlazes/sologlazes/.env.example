# Base de datos (Supabase)
# DATABASE_URL: connection pooling (puerto 6543, modo "transaction") — para runtime en Vercel
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexión directa (puerto 5432) — solo para migraciones de Prisma
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY=""

# Imágenes (elegir uno)
CLOUDINARY_URL=""
UPLOADTHING_TOKEN=""

# Pagos — se completa recién en el deploy con el cliente (ver PRD, Out of scope v1)
MERCADO_PAGO_ACCESS_TOKEN=""
